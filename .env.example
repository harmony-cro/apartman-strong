# Copy to .env.local and fill in values

# Public site URL (used for metadata canonical URLs)
NEXT_PUBLIC_SITE_URL=https://apartmanstrong.hr

# Server port (default: 3000)
PORT=3000

# ─── Enquiry form email (Brevo SMTP, same as autoskola-ezra) ─────────────────
# Without SMTP_HOST the form dry-runs (logs + returns success) — safe for staging.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=                       # Brevo login, e.g. xxxxxx@smtp-brevo.com (a service identity)
SMTP_PASS=                       # Brevo SMTP key
MAIL_FROM=noreply@apartmanstrong.hr   # must be a Brevo-verified sender
ENQUIRY_TO=sb.dejan@gmail.com    # where enquiries are delivered
